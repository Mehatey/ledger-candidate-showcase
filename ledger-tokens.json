{
  "$description": "Ledger design tokens. In Figma: Plugins, Tokens Studio, Import, choose this file, then Export to Figma variables. The light and dark sets become two modes on one collection. Naming follows function rather than appearance, so a theme is a value swap and never a new component rule. Every colour pairing in both sets was verified against WCAG AA with contrast.js.",
  "global": {
    "space": {
      "1": {
        "$type": "number",
        "$value": 4,
        "$description": "4px step"
      },
      "2": {
        "$type": "number",
        "$value": 8,
        "$description": "8px step"
      },
      "3": {
        "$type": "number",
        "$value": 12,
        "$description": "12px step"
      },
      "4": {
        "$type": "number",
        "$value": 16,
        "$description": "16px step"
      },
      "5": {
        "$type": "number",
        "$value": 24,
        "$description": "24px step"
      },
      "6": {
        "$type": "number",
        "$value": 32,
        "$description": "32px step"
      },
      "7": {
        "$type": "number",
        "$value": 48,
        "$description": "48px step"
      },
      "8": {
        "$type": "number",
        "$value": 64,
        "$description": "64px step"
      }
    },
    "radius": {
      "chip": {
        "$type": "number",
        "$value": 6,
        "$description": "Chips, tags, keys"
      },
      "control": {
        "$type": "number",
        "$value": 9,
        "$description": "Buttons and segmented controls"
      },
      "card": {
        "$type": "number",
        "$value": 14,
        "$description": "Media frames and screenshots"
      },
      "panel": {
        "$type": "number",
        "$value": 18,
        "$description": "Cards and rail panels"
      },
      "sheet": {
        "$type": "number",
        "$value": 22,
        "$description": "Tour card, palette, tiles"
      }
    },
    "font": {
      "display": {
        "$type": "fontFamilies",
        "$value": "Instrument Serif",
        "$description": "Names and headings"
      },
      "sans": {
        "$type": "fontFamilies",
        "$value": "Instrument Sans",
        "$description": "Interface text"
      },
      "mono": {
        "$type": "fontFamilies",
        "$value": "JetBrains Mono",
        "$description": "Metadata and numbers"
      }
    },
    "type": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Instrument Serif",
          "fontWeight": "Regular",
          "fontSize": "34",
          "lineHeight": "115%",
          "letterSpacing": "-2%"
        },
        "$description": "Candidate names, page titles"
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Instrument Sans",
          "fontWeight": "SemiBold",
          "fontSize": "13",
          "lineHeight": "140%",
          "letterSpacing": "-0.4%"
        },
        "$description": "Card headers"
      },
      "lede": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Instrument Sans",
          "fontWeight": "Regular",
          "fontSize": "15.5",
          "lineHeight": "160%",
          "letterSpacing": "-0.4%"
        },
        "$description": "Summaries"
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Instrument Sans",
          "fontWeight": "Regular",
          "fontSize": "13.5",
          "lineHeight": "170%",
          "letterSpacing": "-0.4%"
        },
        "$description": "Long form"
      },
      "meta": {
        "$type": "typography",
        "$value": {
          "fontFamily": "JetBrains Mono",
          "fontWeight": "Regular",
          "fontSize": "11.5",
          "lineHeight": "150%",
          "letterSpacing": "0"
