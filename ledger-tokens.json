      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "JetBrains Mono",
          "fontWeight": "Regular",
          "fontSize": "10.5",
          "lineHeight": "150%",
          "letterSpacing": "14%"
        },
        "$description": "Section labels"
      }
    },
    "motion": {
      "enter": {
        "$type": "cubicBezier",
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Entrances, 620ms"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Exits, 220ms"
      },
      "move": {
        "$type": "cubicBezier",
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Positional moves, 320ms"
      },
      "durEnter": {
        "$type": "number",
        "$value": 620,
        "$description": "ms"
      },
      "durExit": {
        "$type": "number",
        "$value": 220,
        "$description": "ms"
      },
      "durMove": {
        "$type": "number",
        "$value": 320,
        "$description": "ms"
      },
      "stagger": {
        "$type": "number",
        "$value": 60,
        "$description": "ms between siblings"
      }
    },
    "layout": {
      "maxWidth": {
        "$type": "number",
        "$value": 1240,
        "$description": "Content cap"
      },
      "rail": {
        "$type": "number",
        "$value": 340,
        "$description": "Evaluation rail, fixed"
      },
      "gutter": {
        "$type": "number",
        "$value": 32,
        "$description": "Column gap"
      },
      "bpTablet": {
        "$type": "number",
        "$value": 1080,
        "$description": "Stacks below this"
      },
      "bpMobile": {
        "$type": "number",
        "$value": 720,
        "$description": "Single column below this"
      }
    }
  },
